{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-teardown/findings.schema.json",
  "title": "Project Teardown Findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "audited_revision",
    "review_status",
    "core_workflows_fully_exercised",
    "generated_at",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "audited_revision": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "complete",
        "provisional"
      ]
    },
    "core_workflows_fully_exercised": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "location",
        "claim"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "category",
        "severity",
        "confidence",
        "verification_state",
        "status",
        "impact",
        "evidence",
        "expected_behavior",
        "actual_behavior",
        "root_cause",
        "affected_components",
        "recommendation",
        "if_implemented",
        "if_unchanged",
        "dependencies",
        "dependents",
        "conflicts",
        "acceptance_criteria",
        "verification",
        "estimated_scope",
        "regression_risk",
        "action",
        "strategic_classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "defect",
            "shortcoming",
            "recommendation",
            "opportunity",
            "investigation",
            "strength"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "confidence": {
          "enum": [
            "confirmed",
            "high",
            "medium",
            "low"
          ]
        },
        "verification_state": {
          "enum": [
            "behaviorally-verified",
            "defect-conclusively-demonstrated",
            "operationally-unverified",
            "partially-verified",
            "source-only",
            "research-verified",
            "owner-provided",
            "blocked",
            "not-applicable"
          ]
        },
        "status": {
          "enum": [
            "open",
            "blocked",
            "decision-required",
            "accepted-risk",
            "retained"
          ]
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "actual_behavior": {
          "type": "string",
          "minLength": 1
        },
        "root_cause": {
          "type": "string",
          "minLength": 1
        },
        "affected_components": {
          "$ref": "#/$defs/stringArray"
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "if_implemented": {
          "type": "string",
          "minLength": 1
        },
        "if_unchanged": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "$ref": "#/$defs/stringArray"
        },
        "dependents": {
          "$ref": "#/$defs/stringArray"
        },
        "conflicts": {
          "$ref": "#/$defs/stringArray"
        },
        "acceptance_criteria": {
          "$ref": "#/$defs/stringArray"
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "estimated_scope": {
          "enum": [
            "trivial",
            "small",
            "medium",
            "large",
            "initiative"
          ]
        },
        "regression_risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "action": {
          "enum": [
            "fix",
            "add",
            "change",
            "remove",
            "investigate",
            "decide",
            "retain"
          ]
        },
        "strategic_classification": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
