{
  "schema_version": 1,
  "name": "seo-teardown",
  "targets": ["claude-code", "codex", "claude-desktop-code", "chatgpt-desktop-codex"],
  "required_files": [
    "SKILL.md",
    "references/audit-methodology.md",
    "references/forward-testing.md",
    "references/platform-research.md",
    "references/report-contract.md",
    "scripts/render_handoff.py",
    "scripts/test_malformed_input.py",
    "scripts/test_validator.py",
    "scripts/validate_seo_teardown.py",
    "scripts/validate_skill.py",
    "assets/icon.svg",
    "agents/openai.yaml"
  ],
  "forbidden_files": [],
  "frontmatter": {
    "keys": "claude-standard",
    "description_min_length": 80
  },
  "tests": [
    {
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        ".",
        "-p",
        "test_*.py"
      ],
      "cwd": "scripts",
      "timeout_seconds": 300
    }
  ]
}
